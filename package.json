{
  "name": "daybook-secretary",
  "version": "1.2.0",
  "description": "日序 — 離線 Windows 私人秘書",
  "author": "Casanova033822",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node tests/desktop.mjs",
    "test:release": "node tests/release.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "export:source": "node scripts/export-source.mjs",
    "licenses": "node scripts/generate-notices.mjs",
    "start": "node scripts/start.mjs",
    "dist": "npm run licenses && npm run build && electron-builder --win nsis --x64 --publish never && npm run audit:release",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.20",
    "@fullcalendar/daygrid": "6.1.20",
    "@fullcalendar/interaction": "6.1.20",
    "@fullcalendar/react": "6.1.20",
    "@fullcalendar/timegrid": "6.1.20",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.3",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "tw.daybook.secretary",
    "productName": "日序",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE",
      "!**/*.map"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "日序",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Daybook-Setup-${version}.${ext}"
    }
  }
}
